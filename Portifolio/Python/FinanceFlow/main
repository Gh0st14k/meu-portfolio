
import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
from datetime import datetime

# Banco de dados
conn = sqlite3.connect("financeflow.db")
cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS transactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    description TEXT NOT NULL,
    category TEXT NOT NULL,
    type TEXT NOT NULL,
    amount REAL NOT NULL,
    date TEXT NOT NULL
)
""")
conn.commit()


class FinanceFlow:
    def __init__(self, root):
        self.root = root
        self.root.title("FinanceFlow - Controle Financeiro")
        self.root.geometry("900x600")
        self.root.configure(bg="#F1F5F9")

        self.create_interface()
        self.load_transactions()
        self.update_balance()

    def create_interface(self):
        header = tk.Frame(self.root, bg="#172554", height=85)
        header.pack(fill="x")

        tk.Label(
            header,
            text="FinanceFlow",
            font=("Arial", 23, "bold"),
            fg="white",
            bg="#172554"
        ).pack(pady=22)

        cards = tk.Frame(self.root, bg="#F1F5F9")
        cards.pack(fill="x", padx=20, pady=15)

        self.balance_label = tk.Label(
            cards, text="Saldo: R$ 0.00",
            font=("Arial", 16, "bold"),
            fg="#166534", bg="white", padx=20, pady=20
        )
        self.balance_label.pack(fill="x")

        form = tk.LabelFrame(
            self.root,
            text="Nova movimentação",
            bg="#F1F5F9",
            padx=15, pady=15
        )
        form.pack(fill="x", padx=20, pady=10)

        self.description = tk.Entry(form, width=22)
        self.description.grid(row=0, column=0, padx=5)

        self.category = ttk.Combobox(
            form,
            values=["Alimentação", "Transporte",
                    "Moradia", "Lazer", "Salário", "Outros"],
            state="readonly",
            width=17
        )
        self.category.grid(row=0, column=1, padx=5)
        self.category.set("Outros")

        self.type = ttk.Combobox(
            form,
            values=["Receita", "Despesa"],
            state="readonly",
            width=12
        )
        self.type.grid(row=0, column=2, padx=5)
        self.type.set("Despesa")

        self.amount = tk.Entry(form, width=12)
        self.amount.grid(row=0, column=3, padx=5)

        tk.Button(
            form, text="Adicionar",
            bg="#2563EB", fg="white",
            command=self.add_transaction
        ).grid(row=0, column=4, padx=10)

        table_frame = tk.Frame(self.root)
        table_frame.pack(fill="both", expand=True, padx=20, pady=10)

        columns = ("ID", "Descrição", "Categoria",
                   "Tipo", "Valor", "Data")

        self.table = ttk.Treeview(
            table_frame, columns=columns,
            show="headings"
        )

        for column in columns:
            self.table.heading(column, text=column)
            self.table.column(column, width=120)

        self.table.pack(fill="both", expand=True)

        tk.Button(
            self.root,
            text="Excluir movimentação selecionada",
            bg="#DC2626", fg="white",
            command=self.delete_transaction
        ).pack(pady=10)

    def add_transaction(self):
        description = self.description.get().strip()
        category = self.category.get()
        transaction_type = self.type.get()

        try:
            amount = float(self.amount.get().replace(",", "."))
            if amount <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror(
                "Erro", "Informe um valor maior que zero."
            )
            return

        if not description:
            messagebox.showerror(
                "Erro", "Informe a descrição."
            )
            return

        cursor.execute("""
            INSERT INTO transactions
            (description, category, type, amount, date)
            VALUES (?, ?, ?, ?, ?)
        """, (
            description,
            category,
            transaction_type,
            amount,
            datetime.now().strftime("%d/%m/%Y")
        ))

        conn.commit()

        self.description.delete(0, tk.END)
        self.amount.delete(0, tk.END)

        self.load_transactions()
        self.update_balance()

    def load_transactions(self):
        for item in self.table.get_children():
            self.table.delete(item)

        cursor.execute("""
            SELECT * FROM transactions ORDER BY id DESC
        """)

        for row in cursor.fetchall():
            self.table.insert("", "end", values=row)

    def update_balance(self):
        cursor.execute("""
            SELECT
                COALESCE(SUM(
                    CASE WHEN type = 'Receita'
                    THEN amount ELSE -amount END
                ), 0)
            FROM transactions
        """)

        balance = cursor.fetchone()[0]

        self.balance_label.config(
            text=f"Saldo disponível: R$ {balance:.2f}"
        )

    def delete_transaction(self):
        selected = self.table.selection()

        if not selected:
            messagebox.showwarning(
                "Atenção", "Selecione uma movimentação."
            )
            return

        transaction_id = self.table.item(
            selected[0], "values"
        )[0]

        if messagebox.askyesno(
            "Confirmação", "Deseja excluir esta movimentação?"
        ):
            cursor.execute(
                "DELETE FROM transactions WHERE id = ?",
                (transaction_id,)
            )
            conn.commit()
            self.load_transactions()
            self.update_balance()


if __name__ == "__main__":
    root = tk.Tk()
    app = FinanceFlow(root)
    root.mainloop()
    conn.close()

